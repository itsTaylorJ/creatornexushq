rules_version = '2';

// CreatorNexusHQ Firestore access.
// Cloudflare KV is the system of record for usage/limits. Firestore holds the
// durable creator record: profile, the content they make, and their closed
// weeks. A signed-in user may read and write ONLY their own data.
// Everything else is denied — no cross-user access, no anonymous access.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Content — the core object. Every idea, title, tag set, thumbnail score
      // and outcome for one piece of content. This is the creator's record and
      // the thing that makes the product worth returning to.
      match /content/{contentId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Weeks — the weekly review, written once and then immutable. Updates are
      // refused at the rules layer rather than trusting the client, because a
      // rewritten history is worse than no history: the whole value of the
      // record is that it's an honest account of what actually happened.
      match /weeks/{weekId} {
        allow read:   if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // Deny all other collections/documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
